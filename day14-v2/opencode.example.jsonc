{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "day14": {
      "name": "Day14 Gateway",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://just-black-coffe.shop/day14-v2/v1",
        "apiKey": "{env:DAY14_PROXY_TOKEN}",
        "timeout": 150000
      },
      "models": {
        "day14-coder": {
          "name": "Day14 Coder",
          "limit": {
            "context": 65536,
            "output": 8192
          },
          "tool_call": true
        }
      }
    }
  },
  "model": "day14/day14-coder",
  "small_model": "day14/day14-coder"
}
