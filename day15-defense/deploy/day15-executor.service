[Unit]
Description=Day15 fixed Unix executor broker
After=network.target
[Service]
User=root
Group=day15api
ExecStart=/usr/bin/python3 -I /srv/day15-defense/current/server/broker.py
RuntimeDirectory=day15-executor
RuntimeDirectoryMode=0750
UMask=0077
Restart=on-failure
RestartSec=3
MemoryMax=64M
TasksMax=16
TimeoutStopSec=10
KillMode=control-group
StandardOutput=null
StandardError=null
[Install]
WantedBy=multi-user.target
